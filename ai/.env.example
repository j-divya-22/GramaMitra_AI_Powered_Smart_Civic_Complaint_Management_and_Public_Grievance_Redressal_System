# Unset means no confidence-based review cutoff is applied.
# After calibration on held-out validation data, set a value from 0 to 1.
# Predictions below a configured cutoff require review; "normal" always requires verification.
CNN_CONFIDENCE_THRESHOLD=
CNN_ENABLED=true
CNN_MODEL_PATH=./cnn/civic_mobilenet_v3_v3_11.keras
CNN_METADATA_PATH=./cnn/class_metadata_v3.json
LLM_PORT=8001
LLM_PROVIDER=llama_cpp
LLM_MODEL_PATH=./llm/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
