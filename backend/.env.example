# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gramamitra_db
DB_USER=gramamitra_app
DB_PASSWORD=your-local-password

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_REGISTRATION_INVITE_CODE=replace-with-a-private-random-invitation-code-at-least-32-characters

# File Upload
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=./uploads/complaints
CHUNK_SIZE_MB=5

# AI / CNN Service
AI_SERVICE_URL=http://localhost:8000
LLM_SERVICE_URL=http://localhost:8001

# Speech (STT/TTS)
SPEECH_PROVIDER=browser
STT_LANGUAGE_CODES=en,hi,kn,ta,te,ml,mr,bn,gu,pa,ur,or
TTS_LANGUAGE_CODES=en,hi,kn,ta,te,ml,mr,bn,gu,pa,ur,or

# CORS
CORS_ORIGIN=http://localhost:5173

# Geocoding and Regional Insights
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_COUNTRY_CODES=in
NOMINATIM_CONTACT=
NOMINATIM_USER_AGENT=GramaMitra-Regional-Insights/1.0
GEOCODING_REQUEST_INTERVAL_MS=1100
GEOCODING_TIMEOUT_MS=10000
GEOCODING_CACHE_DAYS=30
ADDRESS_SEARCH_CACHE_TTL_MS=1800000
REGIONAL_ENRICHMENT_BATCH_SIZE=10
AMBIGUOUS_ADDRESS_RETRY_MS=86400000
TEMPORARY_ADDRESS_RETRY_MS=600000
NOT_FOUND_ADDRESS_RETRY_MS=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
